<Project>

    <PropertyGroup>
        <Product>ConsoleTools Commando</Product>
        <Company>Dust in the Wind</Company>
        <Copyright>Copyright © Dust in the Wind 2022-2026</Copyright>
        <Authors>Dust in the Wind</Authors>
        <Owners>Dust in the Wind</Owners>
        <NeutralLanguage>en</NeutralLanguage>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/lastunicorn/ConsoleTools.Commando</PackageProjectUrl>
        <RepositoryUrl>https://github.com/lastunicorn/ConsoleTools.Commando</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Link="LICENSE" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\icon.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>